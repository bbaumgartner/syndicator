    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\nconst root = '/files';\nconst raw = String(j.bundle_filename || 'video');\nconst stem = raw.includes('.') ? raw.slice(0, raw.lastIndexOf('.')) : raw;\nconst safe = stem.split('').map((c) => /[a-zA-Z0-9_]/.test(c) ? c : '_').join('').slice(0, 80) || 'video';\nconst local_path = root + '/syndicator-site-' + safe + '-' + Date.now() + '.mp4';\nreturn { json: Object.assign({}, j, { local_path: local_path }) };"
      },
