    {
      "parameters": {
        "operation": "extractFrames",
        "inputFile": "={{ $('Merge Adapt Into Payload').item.json.video_4x5_local }}",
        "frameInterval": "={{ Math.max(1, Math.round(($json.duration || 10) / 5)) }}",
        "frameWidth": 720,
        "maxFrames": 5,
        "framesOutputDir": "=/tmp/frames/{{ $('Parse Reel Payload').item.json.slug }}-{{ $('Parse Reel Payload').item.json.video.index }}",
        "returnBinary": true
      },
      "id": "c6a2fa43-bab3-430c-97f5-c29bd771b308",
      "name": "Extract Frames",
      "type": "n8n-nodes-ffmpeg-studio.ffmpegAnalyze",
      "typeVersion": 1,
      "position": [
        448,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst items = $input.all();\nconst first = items[0];\nconst files = Array.isArray(first.json.files) ? first.json.files : [];\nconst binary = {};\nlet n = 0;\nfunction addBuffer(buffer, fileName) {\n  n += 1;\n  binary['frame' + n] = {\n    data: buffer.toString('base64'),\n    mimeType: 'image/jpeg',\n    fileName: fileName,\n    fileExtension: 'jpg',\n  };\n}\nif (files.length) {\n  for (const filePath of files) {\n    if (!filePath || !fs.existsSync(filePath)) continue;\n    addBuffer(fs.readFileSync(filePath), path.basename(filePath));\n  }\n} else {\n  for (const item of items) {\n    if (!item.binary) continue;\n    for (const key of Object.keys(item.binary)) {\n      n += 1;\n      binary['frame' + n] = item.binary[key];\n    }\n  }\n}\nif (n === 0) {\n  throw new Error('No reel frames extracted');\n}\nreturn [{ json: { ...first.json, frameCount: n, frameKeys: Object.keys(binary).join(',') }, binary }];\n"
      },
