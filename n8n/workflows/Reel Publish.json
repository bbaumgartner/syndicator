      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst p = raw.body ?? raw;\nconst video = p.video && typeof p.video === 'object' ? { ...p.video } : {};\nconst src = String(video.section_text || '');\nconst marker = src.indexOf('[VIDEO]');\nlet clip = src;\nif (marker !== -1) {\n  const before = src.slice(0, marker);\n  const headingAt = Math.max(before.lastIndexOf('\\n### '), before.lastIndexOf('\\n## '));\n  const start = headingAt >= 0 ? headingAt + 1 : 0;\n  const after = src.slice(marker);\n  const nextHeading = after.search(/\\n#{2,3} /);\n  const end = nextHeading === -1 ? src.length : marker + nextHeading;\n  clip = src.slice(start, end).trim();\n}\nif (clip.length > 1800) {\n  const m = clip.indexOf('[VIDEO]');\n  clip = m >= 0 ? clip.slice(Math.max(0, m - 500), m + 1000).trim() : clip.slice(0, 1800);\n}\nvideo.clip_context = clip || src.slice(0, 1200);\np.video = video;\nreturn [{ json: p }];\n"
      },
