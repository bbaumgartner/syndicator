        224,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Resolve Paths').first().json;\nreturn [{ json: {\n  ...p,\n  method: 'saliency',\n  motion_threshold: 0.5,\n  padding_method: 'blur',\n} }];"
      },
