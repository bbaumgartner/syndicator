    {
      "parameters": {
        "jsCode": "const frames = $('Merge Frames').first();\nreturn [{\n  json: { ...$input.first().json, frameKeys: frames.json.frameKeys, frameCount: frames.json.frameCount },\n  binary: frames.binary,\n}];\n"
      },
      "id": "ff686fa2-3ac7-46db-886a-1a2ec8c5e470",
      "name": "Attach Frames for YT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -224
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst text = String(raw?.[0]?.content?.[0]?.text ?? '').trim();\nconst titleMatch = text.match(/^TITLE:\\s*(.+)$/im);\nconst descMatch = text.match(/DESCRIPTION:\\s*([\\s\\S]*)$/i);\nlet title = (titleMatch?.[1] || '').trim().split('\\n')[0].trim();\nlet description = (descMatch?.[1] || '').trim();\nif (!title) title = text.split('\\n').map((l) => l.trim()).find(Boolean) || 'Sailing Nomads';\nif (!description) description = text;\ntitle = title.replace(/^TITLE:\\s*/i, '').slice(0, 100).trim();\nif (title.length < 2) title = 'Sailing Nomads';\nreturn [{ json: { title, description } }];"
      },
      "id": "ee51c944-9bd2-4c66-8f38-60c818b66236",
      "name": "Parse YT Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
