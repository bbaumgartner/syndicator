        1344,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "const MAX_BYTES = 95 * 1024 * 1024;\nconst meta = $input.first().json;\nconst plan = $('Plan Reframe').first().json;\nconst inputPath = plan.video_4x5_local;\nconst duration = Number(meta.duration) || 0;\nif (!duration || duration <= 0) {\n  throw new Error('Cannot compress 4x5: missing duration');\n}\nconst audioBr = Number(meta.audio && meta.audio.bitrate) || 128000;\nconst targetBps = (MAX_BYTES * 8 * 0.90) / duration;\nconst videoBps = Math.max(500000, Math.floor(targetBps - audioBr));\nconst videoKbps = Math.floor(videoBps / 1000);\nconst maxrateKbps = Math.floor(videoKbps * 1.15);\nconst bufsizeKbps = videoKbps * 2;\nfunction quote(p) {\n  return '\"' + String(p).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"') + '\"';\n}\nconst tmpPath = String(inputPath).replace(/\\.mp4$/i, '') + '.cap.tmp.mp4';\nconst customArgs = `-y -i ${quote(inputPath)} -c:v libx264 -preset medium -b:v ${videoKbps}k -maxrate ${maxrateKbps}k -bufsize ${bufsizeKbps}k -pix_fmt yuv420p -c:a aac -b:a 128k -ac 2 -ar 48000 -movflags +faststart ${quote(tmpPath)}`;\nreturn [{ json: { inputPath, tmpPath, videoKbps, customArgs, originalSize: meta.size, duration } }];"
      },
      "id": "f7b0148b-764f-49d4-b20e-b822c6152124",
