    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst slug = String(j.slug || 'unknown');\nconst index = Number(j.index || 1);\nconst source_filename = String(j.source_filename || '').trim();\nconst source_sftp_path = '/syndicator/' + slug + '/source/' + source_filename;\nconst base = '/files';\nconst safeSlug = slug.split('').map((c) => /[a-zA-Z0-9_]/.test(c) ? c : '_').join('').slice(0, 60);\nconst stamp = safeSlug + '-' + index + '-' + Date.now();\nconst source_local = base + '/syndicator-source-' + stamp + '.mp4';\nreturn [{ json: {\n  slug: slug,\n  index: index,\n  source_filename: source_filename,\n  source_sftp_path: source_sftp_path,\n  source_local: source_local,\n  video_4x5_local: base + '/syndicator-video-' + stamp + '-4x5.mp4',\n  video_9x16_local: base + '/syndicator-video-' + stamp + '-9x16.mp4',\n  video_4x5_sftp: '/syndicator/' + slug + '/reels/4x5/' + index + '.mp4',\n  video_9x16_sftp: '/syndicator/' + slug + '/reels/9x16/' + index + '.mp4',\n} }];"
      },
      "id": "46f8dd7d-9ead-45cf-ad9c-a6e0be30a879",
