      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst { inputPath, tmpPath, videoKbps, originalSize } = $('Plan Compress 4x5').first().json;\nif (!fs.existsSync(tmpPath)) {\n  throw new Error('Compressed 4x5 missing: ' + tmpPath);\n}\nfs.renameSync(tmpPath, inputPath);\nconst size = fs.statSync(inputPath).size;\nreturn [{ json: { aspect: '4x5', inputPath, size, originalSize, videoKbps, compressed: true } }];"
      },
