    {
      "id": "71dd7ca8-c91b-456c-b8a0-b26a1916bca3",
      "name": "Analyze YT Highlights",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1792,
        -640
      ],
      "parameters": {
        "binaryPropertyName": "data",
        "inputType": "binary",
        "modelId": {
          "__rl": true,
          "cachedResultName": "models/gemini-2.5-flash",
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "operation": "analyze",
        "options": {
          "maxOutputTokens": 8192
        },
        "resource": "video",
        "simplify": true,
        "text": "=You are choosing YouTube Shorts from a long travel video for \"Sailing Nomads\", a personal sailing and travel blog by a Swiss couple sailing Europe with their dog Charly. Write in English. This file is {{ $('Analyze YT Duration').item.json.duration }} seconds long.\n\nWatch the whole video, picture and soundtrack. Propose standalone Shorts: each clip must make sense without the rest of the film. Prefer visually striking, complete mini-stories with a clear beginning and payoff. Skip recaps, uneventful transit, and anything that only works as the middle of a longer scene.\n\nNearby blog text (use it only to name things that are actually in a clip; do not invent a place from the text if you cannot see or hear it in that clip):\nSection title: {{ $('Parse Reel Payload').item.json.video.section_title }}\n\n{{ $('Parse Reel Payload').item.json.video.clip_context }}\n\nConstraints:\n- 3 to 5 clips\n- each 20 to 60 seconds\n- start_sec and end_sec are seconds from the start of THIS file\n- clips must not overlap\n- 0 <= start_sec < end_sec <= {{ $('Analyze YT Duration').item.json.duration }}\n- rank best first (score 0-10)\n\nFor each clip also write a YouTube title and description. Title: max 70 characters, punchy, no hashtags. Description: 1 or 2 short sentences about what THAT clip shows, at most one emoji. Then \"Read more.\" End with 2 to 4 relevant hashtags including #Shorts, each starting with #. Do NOT include any URL. Write only about what happens between start_sec and end_sec. If it is not in that window, do not write it. Do not summarize the blog post. If a distinctive building, monument, or place is visible in that window, find its name in the nearby text and use that name. Do not write about a road, city, or scene from the text unless it is visible in that window. End the description with a plain \"Read more.\" That is the only call to action. No questions to the reader. Avoid AI tells: never use the em dash; avoid words like delve, tapestry, vibrant, crucial, seamless, robust, leverage, foster, realm, and journey cliches. Sound like a real person writing to friends.\n\nReturn ONLY JSON (no markdown) with this shape:\n{\"clips\":[{\"start_sec\":0,\"end_sec\":30,\"score\":8,\"reason\":\"short reason\",\"title\":\"title\",\"description\":\"sentences Read more. #tag #Shorts\"}]}"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "1bxsnPC5Uru2V9v2",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "notes": "One Flash call returns clip windows plus YouTube title and description. maxOutputTokens must stay high so JSON is not truncated.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "0608fa9b-0818-41ef-894d-9e92b8b13b52",
      "name": "Parse YT Highlights",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        -640
      ],
      "parameters": {
        "jsCode": "function extractText(j) {\n  if (typeof j === 'string') return j;\n  if (!j || typeof j !== 'object') return '';\n  if (typeof j.text === 'string') return j.text;\n  const parts = j.content?.parts;\n  if (Array.isArray(parts)) {\n    const t = parts.map((p) => (p && p.text) || '').join('\\n');\n    if (t.trim()) return t;\n  }\n  if (typeof j.content === 'string') return j.content;\n  if (Array.isArray(j.candidates)) return extractText(j.candidates[0]);\n  if (Array.isArray(j) && j[0]) return extractText(j[0]);\n  return '';\n}\n\nconst duration = Number($('Analyze YT Duration').first().json.duration || 0);\nconst payload = $('Parse Reel Payload').first().json;\nconst src9 = $('Merge Adapt Into Payload').first().json.video_9x16_local;\nlet raw = extractText($input.first().json);\nraw = String(raw).trim();\nconst fence = raw.match(/```(?:json)?\\s*([\\s\\S]*?)```/i);\nif (fence) raw = fence[1].trim();\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Gemini highlights were not JSON: ' + raw.slice(0, 400));\n}\nconst clips = Array.isArray(data) ? data : (Array.isArray(data.clips) ? data.clips : []);\nconst out = [];\nconst used = [];\nfor (const clip of clips) {\n  let start = Number(clip.start_sec);\n  let end = Number(clip.end_sec);\n  if (!Number.isFinite(start) || !Number.isFinite(end)) continue;\n  start = Math.max(0, start);\n  end = Math.min(duration, end);\n  if (end - start < 20 || end - start >= 180) continue;\n  const overlap = used.some(([a, b]) => start < b && end > a);\n  if (overlap) continue;\n  let title = String(clip.title || '').trim().replace(/^TITLE:\\s*/i, '').slice(0, 100);\n  let description = String(clip.description || '').trim();\n  if (title.length < 2) title = 'Sailing Nomads';\n  if (!description) continue;\n  used.push([start, end]);\n  const n = out.length + 1;\n  const slug = payload.slug;\n  const index = payload.video.index;\n  const clipPath = '/syndicator/' + slug + '/reels/9x16/' + index + '-yt-' + n + '.mp4';\n  out.push({\n    json: {\n      clipOrdinal: n - 1,\n      clipNumber: n,\n      start_sec: Math.round(start * 100) / 100,\n      end_sec: Math.round(end * 100) / 100,\n      score: Number(clip.score) || 0,\n      title,\n      description,\n      clip_local: clipPath,\n      source_9x16: src9,\n    },\n  });\n}\nreturn out;\n",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
