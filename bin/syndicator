#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

usage() {
  cat <<'EOF'
Usage: bin/syndicator <command>

  verify      Reconcile n8n, then check health, webhooks, pyautoflip, and SFTP
  export      Export sanitized workflows from n8n
  logs        Follow Compose service logs
EOF
}

command="${1:-help}"
shift || true

case "$command" in
  verify)
    exec "$ROOT/scripts/verify.sh" "$@"
    ;;
  export)
    exec "$ROOT/scripts/export-workflows.sh" "$@"
    ;;
  logs)
    compose logs -f "$@"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
